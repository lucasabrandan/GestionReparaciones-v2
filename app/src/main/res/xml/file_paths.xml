<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Esta ruta permite a FileProvider compartir archivos
      desde el directorio 'Pictures' que está dentro del
      almacenamiento privado de la app.
      Ej: /storage/emulated/0/Android/data/com.example.gestionreparacionesapp/files/Pictures
    -->
    <external-files-path
        name="my_images"
        path="Pictures" />
</paths>