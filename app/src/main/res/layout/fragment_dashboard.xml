<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:background="?attr/colorSurfaceContainer"
    android:fitsSystemWindows="true"
    tools:context=".ui.home.DashboardFragment">

    <!-- MEJORA 1: Logo añadido para coherencia de marca -->
    <ImageView
        android:id="@+id/ivLogoDashboard"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:src="@drawable/app_logo"
        android:contentDescription="@string/app_name" />

    <!-- Título de Bienvenida -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorPrimary"
        tools:text="¡Bienvenido, Esteban Martínez!" />

    <!-- Botones de Acción Principales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- MEJORA 2 y 3: Icono y Color de Marca (Secundario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ventas"
            android:layout_marginBottom="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_ventas"
            app:backgroundTint="@color/blue_button"
            android:textColor="@color/background"
            style="@style/Widget.Material3.Button"/>

        <!-- MEJORA 2 y 3: Icono y Color de Marca (Secundario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReparaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reparaciones"
            android:layout_marginBottom="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_reparaciones"
            app:backgroundTint="@color/blue_button"
            android:textColor="@color/background"
            style="@style/Widget.Material3.Button"/>

        <!-- MEJORA 2 y 3: Icono y Color de Marca (Secundario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clientes"
            android:layout_marginBottom="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_clientes"
            app:backgroundTint="@color/blue_button"
            android:textColor="@color/background"
            style="@style/Widget.Material3.Button"/>

        <!-- MEJORA 2 y 3: Icono y Color de Marca (Secundario) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/productos"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_productos"
            app:backgroundTint="@color/blue_button"
            android:textColor="@color/background"
            style="@style/Widget.Material3.Button"/>

    </LinearLayout>
</LinearLayout>