<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:background="?attr/colorSurfaceContainer"
    android:fitsSystemWindows="true"
    tools:context=".ui.home.DashboardFragment">

    <!-- Logo (Restaurado según tu preferencia anterior) -->
    <ImageView
        android:id="@+id/ivLogoDashboard"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:src="@drawable/app_logo"
        android:contentDescription="@string/app_name" />

    <!-- Título de Bienvenida -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorPrimary"
        tools:text="¡Bienvenido, Esteban Martínez!" />

    <!-- Botones de Acción Principales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!--
            TRUCO DE DISEÑO:
            app:iconGravity="textStart" -> Pega el icono al texto y centra el grupo.
            app:iconPadding="8dp" -> Da un pequeño respiro entre icono y texto.
        -->

        <!-- Botón 1: Ventas -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ventas"
            android:layout_marginBottom="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_ventas"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/blue_button"
            android:textColor="?attr/colorOnPrimary"
            app:iconTint="?attr/colorOnPrimary"
            style="@style/Widget.Material3.Button"/>

        <!-- Botón 2: Reparaciones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReparaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reparaciones"
            android:layout_marginBottom="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_reparaciones"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/blue_button"
            android:textColor="?attr/colorOnPrimary"
            app:iconTint="?attr/colorOnPrimary"
            style="@style/Widget.Material3.Button"/>

        <!-- Botón 3: Clientes -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clientes"
            android:layout_marginBottom="16dp"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_clientes"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/blue_button"
            android:textColor="?attr/colorOnPrimary"
            app:iconTint="?attr/colorOnPrimary"
            style="@style/Widget.Material3.Button"/>

        <!-- Botón 4: Productos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/productos"
            android:paddingVertical="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_productos"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:backgroundTint="@color/blue_button"
            android:textColor="?attr/colorOnPrimary"
            app:iconTint="?attr/colorOnPrimary"
            style="@style/Widget.Material3.Button"/>

    </LinearLayout>
</LinearLayout>