<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Spinner de Cliente -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cliente"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/spinnerClienteReparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <!-- Botón para añadir nuevo cliente (UX) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevoClienteDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir Nuevo Cliente"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_gravity="end"/>

        <!-- Descripción Mano de Obra -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/descripcion_mano_obra">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionReparacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contenedor dinámico para productos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Productos Utilizados"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:id="@+id/containerProductosReparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnadirProductoReparacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir Producto"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginTop="8dp"/>

        <!-- Totales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Total:"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <TextView
                android:id="@+id/tvTotalReparacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorPrimary"/>
        </LinearLayout>

        <!-- Botones de Acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnCancelarReparacionDialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancelar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnGuardarReparacionDialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/guardar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>