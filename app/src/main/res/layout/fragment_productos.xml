<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.productos.ProductosFragment">

    <!-- Contenedor para la lista y el mensaje de "sin productos" -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- CAMBIO: Actualizado el 'hint' -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscadorProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:startIconDrawable="@drawable/ic_search"
            android:hint="Buscar por nombre o SKU...">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscadorProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- RecyclerView (ahora debajo del buscador) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewProductos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tilBuscadorProductos"
            android:padding="8dp"
            tools:listitem="@layout/item_producto" />

        <TextView
            android:id="@+id/tvSinProductos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay productos registrados."
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_centerInParent="true"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Botón Flotante (FAB) para añadir nuevos productos -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarProducto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Agregar Nuevo Producto" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>