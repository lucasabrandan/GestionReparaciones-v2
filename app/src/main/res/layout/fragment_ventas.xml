<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.ventas.VentasFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Campo de Búsqueda -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscadorVentas"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:startIconDrawable="@drawable/ic_search"
            android:hint="Buscar por cliente o fecha...">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscadorVentas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- RecyclerView para la lista de ventas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewVentas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tilBuscadorVentas"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_venta" />

        <!-- Mensaje para cuando no hay ventas -->
        <TextView
            android:id="@+id/tvSinVentas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay ventas registradas."
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_centerInParent="true"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Botón Flotante (FAB) para añadir nuevas ventas -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarVenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:srcCompat="@drawable/ic_add"
        android:contentDescription="Agregar Nueva Venta" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
    